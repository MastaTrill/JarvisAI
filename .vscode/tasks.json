{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "shell",
			"label": "func: host start",
			"windows": {
				"command": "& '${workspaceFolder}\\${config:azureFunctions.pythonVenv}\\Scripts\\Activate.ps1'; & 'C:\\Program Files\\Microsoft\\Azure Functions Core Tools\\func.exe' host start"
			},
			"osx": {
				"command": "source ${workspaceFolder}/${config:azureFunctions.pythonVenv}/bin/activate && func host start"
			},
			"linux": {
				"command": "source ${workspaceFolder}/${config:azureFunctions.pythonVenv}/bin/activate && func host start"
			},
			"problemMatcher": [],
			"isBackground": true,
			"dependsOn": "pip install (functions)"
		},
		{
			"label": "pip install (functions)",
			"type": "shell",
			"osx": {
				"command": "${config:azureFunctions.pythonVenv}/bin/python -m pip install -r requirements.txt"
			},
			"windows": {
				"command": "${config:azureFunctions.pythonVenv}\\Scripts\\python -m pip install -r requirements.txt"
			},
			"linux": {
				"command": "${config:azureFunctions.pythonVenv}/bin/python -m pip install -r requirements.txt"
			},
			"problemMatcher": []
		},
		{
			"label": "smoke: local endpoints",
			"type": "shell",
			"osx": {
				"command": "pwsh -NoProfile -File scripts/smoke-local.ps1"
			},
			"windows": {
				"command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\smoke-local.ps1"
			},
			"linux": {
				"command": "pwsh -NoProfile -File scripts/smoke-local.ps1"
			},
			"problemMatcher": []
		},
		{
			"label": "dev: up local",
			"type": "shell",
			"osx": {
				"command": "pwsh -NoProfile -File scripts/dev-up.ps1"
			},
			"windows": {
				"command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\dev-up.ps1"
			},
			"linux": {
				"command": "pwsh -NoProfile -File scripts/dev-up.ps1"
			},
			"problemMatcher": []
		}
	]
}